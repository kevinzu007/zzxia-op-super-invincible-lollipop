# cloudflare
# ./acme.sh --issue --dns dns_cf -d example.com -d '*.example.com'
export CF_Token="xxxxxxxxxxxxxxxxxxxxxxxxx"
#export CF_Account_ID="yyy"     #-- acme.sh 自动获取了
#export CF_Zone_ID=“zzz”     #-- acme.sh 自动获取了
#curl -X GET "https://api.cloudflare.com/client/v4/zones?name=zzxia.vip"      -H "Authorization: Bearer ${CF_Token}"      -H "Content-Type: application/json" | jq

# aliyun
# ./acme.sh --issue --dns dns_ali -d example.com -d *.example.com
export Ali_Key="<key>"
export Ali_Secret="<secret>"

# Godaddy
# ./acme.sh --issue --dns dns_gd --dnssleep 600 -d example.com -d *.example.com
export GD_Key="<key>"
export GD_Secret="<secret>"

# DNSPod.cn
# ./acme.sh --issue --dns dns_dp -d example.com -d *.example.com
export DP_Id="<id>"
export DP_Key="<key>"


